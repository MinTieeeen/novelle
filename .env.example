# Novelle: ONE settings file for everything (backend scripts, docker compose, category_lab).
# Copy to novelle/.env and fill in the secrets. novelle/.env is never committed.
#
# This template is committed and the lab also reads it as its lowest layer, so every non-secret key
# below has a working default; a new setting is added HERE (with its default) for everyone.
# Values with spaces are quoted so that `source .env` in bash works too.

# --- Docker compose (host ports) -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001

# --- SQL Server on AWS RDS (novelle_backend/scripts/db-*.ps1|.sh, category_lab) ---------------------
DB_HOST=
# RDS master user: bootstrap only (logins, database).
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
# Passwords of the three logins created by database/bootstrap/01_create_logins_users.sql.
MIGRATOR_PASSWORD=
APP_PASSWORD=
RO_PASSWORD=
# Password of the seeded demo accounts (db-seed makes a BCrypt hash of it), or a ready hash in
# DEMO_PASSWORD_HASH ("$2a$10$...").
DEMO_PASSWORD=

# --- novelle_backend: rate limits (@RateLimited, Redis key rl:<name>:<ip|userId>) -----------------
# Windows are Spring durations (60s, 15m, 1h). RL_ENABLED=false turns every limit off.
RL_ENABLED=true
RL_LOGIN_MAX=10
RL_LOGIN_WINDOW=60s
RL_REGISTER_MAX=5
RL_REGISTER_WINDOW=1h
# GET /api/stories (full-text search), per IP.
RL_SEARCH_MAX=60
RL_SEARCH_WINDOW=60s
# PUT /api/reading-progress/{storyId}, per user.
RL_PROGRESS_MAX=120
RL_PROGRESS_WINDOW=60s
# PUT / DELETE /api/stories/{id}/ratings/me, per user.
RL_RATING_MAX=10
RL_RATING_WINDOW=60s
# PUT / DELETE /api/stories/{id}/follow and /api/authors/{id}/follow, per user.
RL_FOLLOW_MAX=60
RL_FOLLOW_WINDOW=60s
# POST /api/author-requests, per user.
RL_AUTHOR_REQUEST_MAX=3
RL_AUTHOR_REQUEST_WINDOW=1d
# POST /api/studio/stories, per author.
RL_STORY_CREATE_MAX=10
RL_STORY_CREATE_WINDOW=1h
# POST /api/studio/chapters/{id}/publish, per author.
RL_PUBLISH_MAX=10
RL_PUBLISH_WINDOW=60s
# PUT /api/studio/chapters/{id}/draft (editor autosave), per author.
RL_DRAFT_MAX=30
RL_DRAFT_WINDOW=60s

# --- novelle_backend: Redis cache-aside (keys cache:*), Spring durations --------------------------
CACHE_GENRE_TTL=1h
CACHE_HOME_TTL=2m
CACHE_STORY_TTL=10m
CACHE_CHAPTER_TTL=30m
# Admin statistics (/api/admin/stats/*), expire by themselves.
CACHE_STATS_TTL=5m

# --- novelle_backend: view counting (Redis, flushed to SQL Server by sp_FlushViews) ---------------
# Keys {prefix}story|chapter:{id}:{yyyyMMdd}, {prefix}dirty, {prefix}seen:{chapterId}:{viewer}.
# The same viewer counts once per chapter within VIEWS_SEEN_TTL; the day is taken in VIEWS_ZONE.
VIEWS_KEY_PREFIX=views:
VIEWS_SEEN_TTL=30m
VIEWS_ZONE=Asia/Ho_Chi_Minh
VIEWS_FLUSH_INTERVAL=60s
VIEWS_FLUSH_BATCH=1000
VIEWS_FLUSH_MAX_BATCHES=20

# --- novelle_backend: background jobs (@Scheduled) -----------------------------------------------
# false = no view flush (counters pile up in Redis) and no scheduled chapter publishing.
# Only for tests and local checks.
JOBS_ENABLED=true

# --- novelle_backend: public catalog (F1 home page) ----------------------------------------------
# Stories per home block; ratings a story needs to enter the "top rated" block.
CATALOG_HOME_SIZE=12
CATALOG_TOP_RATED_MIN_RATINGS=10

# --- novelle_backend: personal library (F5 reading lists) ----------------------------------------
READING_LIST_MAX_LISTS=50
READING_LIST_MAX_ITEMS=500

# --- novelle_backend: author requests (F7 / F11) -------------------------------------------------
# true = take the Redis lock lock:author-request:{id} (SET NX PX) before calling the approve / reject
# procedure, to compare with their UPDLOCK in the concurrency demo. The procedures guard correctness anyway.
APP_DEMO_REDIS_LOCK=false
AUTHOR_REQUEST_LOCK_TTL=5s

# --- novelle_backend: author studio (F8–F10) ------------------------------------------------------
# Autosaved chapter drafts live in Redis (draft:{userId}:{chapterId}) for STUDIO_DRAFT_TTL.
STUDIO_DRAFT_TTL=7d
# Characters a chapter body may have before HTML sanitizing.
STUDIO_CONTENT_MAX_LENGTH=200000
# A chapter can be scheduled between now + MIN_LEAD and now + MAX_AHEAD.
STUDIO_SCHEDULE_MIN_LEAD=1m
STUDIO_SCHEDULE_MAX_AHEAD=365d
# Delay between two runs of the job that calls sp_PublishScheduled (needs JOBS_ENABLED=true).
STUDIO_PUBLISH_INTERVAL=60s

# --- category_lab: Redis target used when --target is not given: local | aws -----------------------
LAB_TARGET=local

# --- category_lab: SQL Server ------------------------------------------------------------------------
# The password is chosen by login name from the keys above; LAB_SQL_PASSWORD overrides it.
# novelle_migrator is needed for DDL on the lab.* sandbox tables.
LAB_SQL_USER=novelle_migrator
LAB_SQL_PASSWORD=
LAB_SQL_PORT=1433
LAB_SQL_DATABASE=NovelleDB
LAB_ODBC_DRIVER="ODBC Driver 18 for SQL Server"
LAB_SQL_LOGIN_TIMEOUT_S=15
LAB_SQL_APP_NAME=novelle-category-lab

# --- category_lab: Redis "local" (docker compose sets the host to "redis" inside the lab container) --
LAB_LOCAL_REDIS_HOST=localhost
LAB_LOCAL_REDIS_PORT=6379
LAB_LOCAL_REDIS_PASSWORD=
LAB_LOCAL_REDIS_DB=0

# --- category_lab: Redis "aws" = Redis on EC2 through the SSM tunnel --------------------------------
LAB_AWS_REDIS_HOST=localhost
LAB_AWS_REDIS_PORT=16379
LAB_AWS_REDIS_PASSWORD=
LAB_AWS_REDIS_DB=0

# --- category_lab: LLM commentary in `lab report` ----------------------------------------------------
# Provider: gemini (a new provider adds its own <PREFIX>_* block below).
LLM_PROVIDER=gemini
# Longest statement / execution plan text sent to the model, per item (characters).
LLM_MAX_STATEMENT_CHARS=1500
LLM_MAX_PLAN_CHARS=2000

# --- Gemini (LLM_PROVIDER=gemini). Key: https://aistudio.google.com/apikey ---------------------------
GEMINI_API_KEY=
# gemini-2.5-flash is no longer available to new keys.
GEMINI_MODEL=gemini-3.8-flash
# Tried in order after the main model. A model whose quota is used up (429) or that this key cannot use
# (404) is skipped at once; free-tier quota is per model, so every extra model adds requests per day.
# Overloaded models (5xx) are first retried after GEMINI_RETRY_DELAYS_S.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest
GEMINI_TEMPERATURE=0.3
GEMINI_TIMEOUT_S=180
# Seconds to wait before each retry of an overloaded model (one value per retry).
GEMINI_RETRY_DELAYS_S=5,15,40
