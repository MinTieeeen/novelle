<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novelle.mapper.SessionContextMapper">

    <!-- the value is a bound parameter (sql_variant INT); read_only stays 0 so the next edit can overwrite it -->
    <update id="setUserId">
        EXEC sys.sp_set_session_context @key = N'user_id', @value = #{userId, jdbcType=INTEGER}
    </update>
</mapper>
