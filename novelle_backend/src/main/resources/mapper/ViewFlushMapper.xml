<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novelle.mapper.ViewFlushMapper">

    <!--
      Stored procedure with a table-valued parameter (dbo.ViewDeltaTable). <update> because it returns no rows;
      the type handler is named explicitly so the mapping does not depend on handler registration order.
    -->
    <update id="flush" statementType="CALLABLE">
        {call dbo.sp_FlushViews(#{batch, typeHandler=com.novelle.infrastructure.mybatis.ViewDeltaBatchTypeHandler})}
    </update>
</mapper>
