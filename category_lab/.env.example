# Copy to category_lab/.env. SQL Server credentials are NOT here: they are read from
# novelle_backend/.env (DB_HOST, MIGRATOR_PASSWORD, RO_PASSWORD, APP_PASSWORD).
# Precedence: real environment variables > category_lab/.env > novelle_backend/.env

# Default Redis target when --target is not given: local | aws
LAB_TARGET=local

# SQL Server (AWS RDS). User: novelle_migrator (needed for DDL on the lab.* sandbox),
# novelle_readonly or novelle_app. The password is picked from novelle_backend/.env by user name;
# set LAB_SQL_PASSWORD only to override it.
LAB_SQL_USER=novelle_migrator
# LAB_SQL_PORT=1433
# LAB_SQL_DATABASE=NovelleDB
# LAB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Redis "local" = docker compose service (inside the lab container the host is "redis")
LAB_LOCAL_REDIS_HOST=localhost
LAB_LOCAL_REDIS_PORT=6379
# Redis "aws" = Redis on EC2 through the SSM tunnel (novelle_backend/scripts/aws-tunnel.*)
LAB_AWS_REDIS_HOST=localhost
LAB_AWS_REDIS_PORT=16379
LAB_AWS_REDIS_PASSWORD=

# Gemini: AI commentary in `lab report`. Key: https://aistudio.google.com/apikey
# gemini-2.5-flash is no longer available to new keys. `gemini-flash-latest` always points to the
# newest Flash model (but the comments may change when Google moves it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model stays overloaded (429/503) after retries.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash
