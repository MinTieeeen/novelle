# DBMS Lab settings. This file is COMMITTED and is also the lowest settings layer: lab reads it first,
# then novelle_backend/.env, then category_lab/.env, then real environment variables (later wins).
# Keep secrets OUT of this file. Put them (and anything you want to change) in category_lab/.env:
#   cp .env.example .env      then keep only the lines you change, e.g. GEMINI_API_KEY=...
# A new setting must be added here, with its default, so it works for every member.

# --- Redis target used when --target is not given: local | aws -----------------------------------------
LAB_TARGET=local

# --- SQL Server (AWS RDS) ----------------------------------------------------------------------------
# DB_HOST and the passwords come from novelle_backend/.env (DB_HOST, MIGRATOR_PASSWORD, APP_PASSWORD,
# RO_PASSWORD). The password is chosen by login name; LAB_SQL_PASSWORD overrides it.
# novelle_migrator is needed for DDL on the lab.* sandbox tables.
LAB_SQL_USER=novelle_migrator
LAB_SQL_PASSWORD=
LAB_SQL_PORT=1433
LAB_SQL_DATABASE=NovelleDB
LAB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
LAB_SQL_LOGIN_TIMEOUT_S=15
LAB_SQL_APP_NAME=novelle-category-lab

# --- Redis "local": docker compose service (compose sets the host to "redis" inside the lab container) --
LAB_LOCAL_REDIS_HOST=localhost
LAB_LOCAL_REDIS_PORT=6379
LAB_LOCAL_REDIS_PASSWORD=
LAB_LOCAL_REDIS_DB=0

# --- Redis "aws": Redis on EC2 through the SSM tunnel (novelle_backend/scripts/aws-tunnel.*) ------------
LAB_AWS_REDIS_HOST=localhost
LAB_AWS_REDIS_PORT=16379
LAB_AWS_REDIS_PASSWORD=
LAB_AWS_REDIS_DB=0

# --- LLM commentary in `lab report` ------------------------------------------------------------------
# Provider: gemini (the only one so far; a new provider adds its own <PREFIX>_* block below).
LLM_PROVIDER=gemini
# Longest statement / execution plan text sent to the model, per item (characters).
LLM_MAX_STATEMENT_CHARS=1500
LLM_MAX_PLAN_CHARS=2000

# --- Gemini (LLM_PROVIDER=gemini). Key: https://aistudio.google.com/apikey -----------------------------
# Set the key in category_lab/.env, never here.
GEMINI_API_KEY=
# gemini-2.5-flash is no longer available to new keys. `gemini-flash-latest` always points to the newest
# Flash model (but the comments may change when Google moves it).
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model stays overloaded (429/5xx) after the retries.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_TIMEOUT_S=180
# Seconds to wait before each retry of an overloaded model (one value per retry).
GEMINI_RETRY_DELAYS_S=5,15,40
