{# An editable comment. Expects `cid` (scenario id or "_topic"), `ctext` (saved text), `clabel`.
   Read-only until the page is served by `lab serve` (report.js enables it when the page carries a token). #}
<div class="comment" data-comment-id="{{ cid }}">
  <div class="comment-head">
    <label class="comment-label" for="comment-{{ cid }}">{{ clabel }}</label>
    <button type="button" class="ai-suggest" disabled
            title="Nhờ Gemini viết đề xuất từ số liệu (cần mở report bằng lab serve)">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="sparkle"><path d="M12 2c.4 3.9 1.6 6.6 3.4 8.3C17.2 12 19.6 12.9 22 13c-2.4.2-4.8 1-6.6 2.7C13.6 17.4 12.4 20.1 12 24c-.4-3.9-1.6-6.6-3.4-8.3C6.8 14 4.4 13.2 2 13c2.4-.1 4.8-1 6.6-2.7C10.4 8.6 11.6 5.9 12 2z"/></svg>
      <span class="ai-suggest-text">Gợi ý bằng Gemini</span>
    </button>
  </div>
  <textarea id="comment-{{ cid }}" class="comment-text" rows="5" readonly
            placeholder="Nhập nhận xét, hoặc bấm “Gợi ý bằng Gemini” rồi chỉnh sửa lại.">{{ ctext }}</textarea>
  <p class="comment-status small" aria-live="polite"></p>
</div>
