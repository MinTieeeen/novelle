<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ topic.title }} · Novelle DBMS Lab</title>
<style>{{ css }}</style>
</head>
<body class="viz-root" data-topic="{{ topic.id }}">
<div class="edit-hint" role="note">
  Report đang ở chế độ chỉ xem. Để nhập nhận xét, nhờ Gemini gợi ý và lưu vào <code>NOTES.md</code>, mở report bằng
  <code>uv run lab serve</code> (trong Docker: <code>docker compose --profile lab run --rm --service-ports lab uv run lab serve</code>).
</div>
<header class="page-head">
  <div>
    <p class="eyebrow">Novelle DBMS Lab · Báo cáo topic · SQL Server và Redis</p>
    <h1>{{ topic.title }}</h1>
    <p class="meta">
      Người thực hiện: <b>{{ topic.owner }}</b> · <code>topics/{{ topic.folder or topic.id }}</code>
      · Redis target <b>{{ env.target }}</b> · tạo lúc {{ generated_at|local_time }} (giờ Việt Nam)
    </p>
  </div>
  <button class="theme-toggle" type="button" aria-label="Đổi giao diện sáng/tối">◐ Giao diện</button>
</header>

<main>
{% set st = tv.stats %}
<section class="tiles" aria-label="Tổng quan topic">
  <div class="tile"><span class="tile-label">Cặp so sánh</span><span class="tile-value">{{ st.pairs }}</span></div>
  <div class="tile"><span class="tile-label">Scenario</span><span class="tile-value">{{ st.scenarios }}</span>
    <span class="tile-sub"><i class="sw s1"></i>SQL Server {{ st.by_dbms.get("sqlserver", 0) }} · <i class="sw s2"></i>Redis {{ st.by_dbms.get("redis", 0) }}</span></div>
  <div class="tile"><span class="tile-label"><span class="st good">✔</span> Đạt</span><span class="tile-value">{{ st.by_status.get("passed", 0) }}</span>
    <span class="tile-sub">{% if st.by_status.get("failed") %}<span class="st critical">✘</span> không đạt {{ st.by_status.failed }} · {% endif %}{% if st.by_status.get("error") %}<span class="st critical">⚠</span> lỗi {{ st.by_status.error }} · {% endif %}{% if st.by_status.get("skipped") %}– bỏ qua {{ st.by_status.skipped }}{% endif %}</span></div>
  <div class="tile"><span class="tile-label">Kiểm chứng</span><span class="tile-value">{{ st.checks_passed }}/{{ st.checks_total }}</span>
    <span class="tile-sub">check đạt</span></div>
  <div class="tile"><span class="tile-label">Số đo</span><span class="tile-value">{{ st.metrics }}</span>
    <span class="tile-sub">tổng thời gian chạy {{ "%.1f"|format(st.duration_s) }} s</span></div>
</section>

<section class="card">
  <h2>Câu hỏi nghiên cứu</h2>
  {% if topic.research_questions %}
  <ol>{% for q in topic.research_questions %}<li>{{ q }}</li>{% endfor %}</ol>
  {% else %}
  <p class="muted">Chưa khai báo câu hỏi nghiên cứu trong <code>__init__.py</code>.</p>
  {% endif %}
  {% if topic.context %}<h3>Bối cảnh</h3><p>{{ topic.context }}</p>{% endif %}
</section>

<section class="card">
  <h2>Môi trường và phương pháp đo</h2>
  <table class="kv">
    <tr><th>SQL Server</th><td>{{ env.sqlserver_version or "?" }} · {{ env.sqlserver_edition or "?" }} · AWS RDS, database {{ env.sql_database }}</td></tr>
    <tr><th>Redis</th><td>{{ env.redis_version or "?" }} · target <b>{{ env.target }}</b>{% if env.target == "local" %} (Docker trên máy chạy lab){% else %} (EC2 qua tunnel SSM){% endif %}</td></tr>
    <tr><th>Thời gian SQL Server</th><td>Câu lệnh chạy K lần trong một batch, giữa hai lần đọc <code>SYSDATETIME()</code> trên server, rồi chia cho K. K được chọn tự động để đủ độ chính xác. Không tính thời gian mạng.</td></tr>
    <tr><th>Thời gian Redis</th><td>Tổng <code>duration</code> của các lệnh trong <code>SLOWLOG</code> (µs, do server ghi). Không tính thời gian mạng.</td></tr>
    <tr><th>Cách đọc số đo</th><td>p50 là trung vị, p95 là giá trị mà 95% lần đo không vượt quá. Dấu * nghĩa là độ phân giải của phép đo lớn hơn 10% giá trị. Chênh lệch nhỏ hơn tổng độ phân giải hai bên được coi là ngang nhau.</td></tr>
  </table>
</section>

{% if tv.summary %}
<section class="card">
  <h2>Tổng hợp các cặp so sánh</h2>
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>Cặp</th><th>Trạng thái</th><th class="num">SQL Server (p50)</th><th class="num">Redis (p50)</th><th>Kết luận</th></tr></thead>
    <tbody>
    {% for r in tv.summary %}
      <tr>
        <td><a href="#pair-{{ topic.id }}-{{ r.pair.key }}">{{ r.pair.title }}</a></td>
        <td class="nowrap">
          {% for d, stt in [("sqlserver", r.sql_status), ("redis", r.redis_status)] %}
            <i class="sw {{ 's1' if d == 'sqlserver' else 's2' }}"></i>{% if stt %}<span class="st {{ status[stt][2] }}" title="{{ status[stt][1] }}">{{ status[stt][0] }}</span>{% else %}<span class="muted">–</span>{% endif %}
          {% endfor %}
        </td>
        <td class="num">{% if r.sql %}{{ r.sql.value|ms }}{% if r.sql.coarse %}*{% endif %}{% else %}–{% endif %}</td>
        <td class="num">{% if r.redis %}{{ r.redis.value|ms }}{% if r.redis.coarse %}*{% endif %}{% else %}–{% endif %}</td>
        <td>
          {% if r.verdict %}{{ r.verdict.text }}{% endif %}
          {% if r.shared %}{% if r.verdict %}<br>{% endif %}<span class="small">{{ r.shared|length }} metric chung được so sánh</span>{% endif %}
          {% if not r.verdict and not r.shared %}–{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

<section class="card">
  <h2>Danh sách scenario</h2>
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>DBMS</th><th>Scenario</th><th>Cặp</th><th>Kết quả</th><th class="num">Check</th><th class="num">Số đo</th><th class="num">Thời gian chạy</th><th>Chạy lúc</th></tr></thead>
    <tbody>
    {% for s in tv.t.scenarios %}
      <tr>
        <td class="nowrap"><i class="sw {{ 's1' if s.dbms == 'sqlserver' else 's2' }}"></i>{{ dbms_name[s.dbms] }}</td>
        <td>{{ s.title }}<br><code class="small">{{ s.id }}</code></td>
        <td>{% if s.pair %}<a href="#pair-{{ topic.id }}-{{ s.pair }}"><code>{{ s.pair }}</code></a>{% else %}<span class="muted">–</span>{% endif %}</td>
        <td class="nowrap"><span class="st {{ status[s.status][2] }}">{{ status[s.status][0] }}</span> {{ status[s.status][1] }}</td>
        <td class="num">{{ s.checks|selectattr("passed")|list|length }}/{{ s.checks|length }}</td>
        <td class="num">{{ s.metrics|length }}</td>
        <td class="num">{{ "%.1f"|format(s.duration_s) }} s</td>
        <td class="nowrap small">{{ s.started_at|local_time }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>

<section class="topic" id="topic-{{ topic.id }}">
  <h2 class="section-title">Chi tiết từng cặp so sánh</h2>
  {% for pv in tv.pairs %}
  {% set p = pv.pair %}
  <article class="card pair" id="pair-{{ topic.id }}-{{ p.key }}">
    {% set pid = "pair-" ~ topic.id ~ "-" ~ p.key %}
    <header class="pair-head">
      <h3>{{ p.title }}</h3>
      <div class="code-tabs" role="tablist" aria-label="Chi tiết từng DBMS">
        {% for dbms, sv in [("sqlserver", pv.sql), ("redis", pv.redis)] %}
        <button type="button" role="tab" id="{{ pid }}-tab-{{ dbms }}" aria-controls="{{ pid }}-code-{{ dbms }}"
                aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ 0 if loop.first else -1 }}">
          <i class="sw {{ 's1' if dbms == 'sqlserver' else 's2' }}"></i>{{ dbms_name[dbms] }}
          {% if sv %}<span class="st {{ sv.status_class }}" aria-label="{{ sv.status_label }}">{{ sv.status_icon }}</span>{% endif %}
        </button>
        {% endfor %}
      </div>
    </header>

    {% if pv.timing_rows or p.shared %}
    <section class="compare">
      <h4>So sánh</h4>
      {% if pv.timing_rows %}
      <div class="figure">
        <div class="legend" aria-hidden="true">
          <span><i class="sw s1"></i>SQL Server</span><span><i class="sw s2"></i>Redis</span>
          <span class="muted">thanh = p50 · vạch = tới p95</span>
        </div>
        {{ pv.chart }}
        {% if p.timing_verdict %}<p class="verdict"><b>{{ p.timing_verdict.text }}</b> <span class="muted">(so biến thể tốt nhất mỗi bên)</span></p>{% endif %}
      </div>
      {% endif %}
      {% if p.shared %}
      <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Metric</th><th class="num">SQL Server</th><th class="num">Redis</th><th>Kết luận</th></tr></thead>
        <tbody>
        {% for r in p.shared %}
          <tr><td>{{ r.name }} · {{ r.label }}</td><td class="num">{{ r.sql|value }}</td><td class="num">{{ r.redis|value }}</td><td>{{ r.verdict.text }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
      {% endif %}
    </section>
    {% endif %}

    <div class="code-panels">
      {% for dbms, sv in [("sqlserver", pv.sql), ("redis", pv.redis)] %}
      <div role="tabpanel" id="{{ pid }}-code-{{ dbms }}" aria-labelledby="{{ pid }}-tab-{{ dbms }}"
           {% if not loop.first %}hidden{% endif %}>
        <h4 class="panel-title"><i class="sw {{ 's1' if dbms == 'sqlserver' else 's2' }}"></i>Chi tiết {{ dbms_name[dbms] }}</h4>
        {% if sv %}{% include "_scenario.html.j2" %}{% else %}<p class="muted small">Chưa có scenario {{ dbms_name[dbms] }} cho cặp này.</p>{% endif %}
      </div>
      {% endfor %}
    </div>
  </article>
  {% endfor %}

  {% if tv.unpaired %}
  <div class="card">
    <h3>Scenario không ghép cặp</h3>
    {% for sv in tv.unpaired %}
      <div class="side solo"><h4><i class="sw {{ 's1' if sv.s.dbms == 'sqlserver' else 's2' }}"></i>{{ dbms_name[sv.s.dbms] }} · {{ sv.s.title }}</h4>
        {% include "_scenario.html.j2" %}</div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="card" id="comment-topic-{{ topic.id }}">
    <h3>Nhận xét chung của nhóm</h3>
    <p class="small">Kết luận cho cả topic, trả lời các câu hỏi nghiên cứu. Được lưu vào <code>NOTES.md</code> cùng nhận xét của từng scenario.</p>
    {% set cid = "_topic" %}{% set ctext = tv.topic_comment %}{% set clabel = "Nhận xét chung" %}
    {% include "_comment.html.j2" %}
  </div>

  <div class="card ai" id="ai-{{ topic.id }}">
    <h3>Nhận xét so sánh SQL Server và Redis <span class="badge">AI · Gemini</span></h3>
    {% if tv.commentary %}
      {% set c = tv.commentary %}
      <p class="ai-note">Do {{ c.model }} sinh từ số liệu của topic{% if c.generated_at %} lúc {{ c.generated_at[:16]|replace("T", " ") }} UTC{% endif %}. Cần đối chiếu với nhận xét của thành viên trước khi đưa vào báo cáo.</p>
      {% if c.stale %}<p class="ai-note"><span class="st critical">⚠</span> Đây là nhận xét từ lần trước: lần này Gemini lỗi ({{ tv.ai_error }}). Số liệu có thể đã thay đổi, chạy lại <code>lab report</code> sau.</p>{% endif %}
      <h4>So sánh theo chủ đề</h4>
      <p>{{ c.comparison }}</p>
      <h4>Khuyến nghị cho Novelle</h4>
      <p>{{ c.recommendation }}</p>
      {% if c.caveats %}<h4>Lưu ý về phép đo</h4><ul>{% for x in c.caveats %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
    {% elif tv.ai_error %}
      <p class="muted">Không tạo được nhận xét AI: {{ tv.ai_error }}</p>
    {% else %}
      <p class="muted">Chưa có nhận xét AI{% if ai_note %} ({{ ai_note }}){% endif %}.</p>
    {% endif %}
  </div>

  {% if tv.notes_html %}
  <div class="card notes">
    <h3>Ghi chú của thành viên <span class="muted">(NOTES.md)</span></h3>
    {{ tv.notes_html }}
  </div>
  {% endif %}

  <section class="card">
    <h3>Các lần chạy được dùng trong report</h3>
    <p class="small">Mỗi scenario lấy kết quả mới nhất của nó; chạy lại một DBMS hay một scenario không làm mất kết quả của phần còn lại.</p>
    <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Lần chạy (thư mục trong <code>results/</code>)</th><th>Bắt đầu</th><th>Target</th><th class="num">Scenario lấy từ lần này</th></tr></thead>
      <tbody>
      {% for r in runs %}
        <tr><td><code>{{ r.run_id }}</code></td><td class="nowrap">{{ r.started_at|local_time }}</td><td>{{ r.target }}</td><td class="num">{{ r.scenarios }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </section>
</section>
</main>

<footer class="page-foot">
  Novelle DBMS Lab · <code>uv run lab report {{ topic.id }}</code> · số liệu gốc trong <code>category_lab/results/</code>
</footer>
<div class="edit-bar" hidden>
  <span class="edit-bar-status" aria-live="polite">Chưa có thay đổi</span>
  <button type="button" class="save-notes" disabled>Lưu vào NOTES.md</button>
</div>
<div class="tooltip" role="tooltip" hidden></div>
<script>{{ js }}</script>
</body>
</html>
